# -*- mode: ruby -*-
Vagrant.configure("2") do |config|

  ("a".."b").each_with_index do |id, i|
    config.vm.define "vm#{id}" do |machine|
      machine.vm.box         = "ubuntu/jammy64"
      machine.vm.box_version = "20241002.0.0"
      machine.vm.box_check_update = false
      machine.vm.hostname    = "vm#{id}"

      # Red host-only: vma = 192.168.56.10, vmb = 192.168.56.11
      # El host queda en 192.168.56.1 (escenario 4b)
      machine.vm.network "private_network", ip: "192.168.56.#{10 + i}"

      machine.vm.provider "virtualbox" do |vb|
        vb.name   = "TP2-vm#{id}"
        vb.memory = "1024"
        vb.cpus   = 1
      end

      # Heredoc con comillas: Ruby no interpreta nada, va literal al shell
      machine.vm.provision "shell", inline: <<-'SHELL'
        set -e
        export DEBIAN_FRONTEND=noninteractive

        apt-get update -qq
        apt-get install -y -qq net-tools joe zip build-essential gdb iperf3

        grep -q "alias ls='ls -la'" /home/vagrant/.bashrc || \
          echo -e "\nalias ls='ls -la'" >> /home/vagrant/.bashrc
      SHELL
    end
  end
end
